{
  "name": "notch",
  "productName": "Notch",
  "version": "0.1.0",
  "description": "Dynamic RAM Notch - Desktop Floating Clipboard & File Staging Utility",
  "author": "Adam Arfa",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:rust": "cargo build --release --manifest-path ../src-tauri/Cargo.toml",
    "desktop": "electron electron-main.cjs",
    "preview": "vite preview",
    "pack": "electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.adamarfa.notch",
    "productName": "Notch",
    "compression": "maximum",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "icon.ico",
      "icon.png",
      "tray-icon.ico",
      "tray-icon.png",
      "drag-icon.png"
    ],
    "extraResources": [
      {
        "from": "../src-tauri/target/release/notch-daemon.exe",
        "to": "notch-daemon.exe"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Notch",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "uninstallDisplayName": "Notch",
      "runAfterFinish": true
    }
  }
}
